#define ZEPH_PROFILE_ULTRA_WAVING_VEGETATION 1
#define ZEPH_PROFILE_ULTRA_WEATHER_QUALITY 3

// Settings deliberately flow in one direction: profile.glsl includes the raw
// controls, while settings.glsl never includes this file. This prevents an
// include cycle and keeps renderer code on the capability-clamped interface.
#include "/lib/settings.glsl"

#if ZEPH_PROFILE_TIER == ZEPH_PROFILE_TIER_POTATO
#define ZEPH_PROFILE_BASE_TIER ZEPH_PROFILE_POTATO_TIER
#define ZEPH_PROFILE_BASE_FOG_QUALITY ZEPH_PROFILE_POTATO_FOG_QUALITY
#define ZEPH_PROFILE_BASE_ATMOSPHERE_QUALITY ZEPH_PROFILE_POTATO_ATMOSPHERE_QUALITY
#define ZEPH_PROFILE_BASE_FACE_LIGHTING_QUALITY ZEPH_PROFILE_POTATO_FACE_LIGHTING_QUALITY
#define ZEPH_PROFILE_BASE_MATERIAL_QUALITY ZEPH_PROFILE_POTATO_MATERIAL_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_QUALITY ZEPH_PROFILE_POTATO_CLOUD_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_TIER ZEPH_PROFILE_POTATO_CLOUD_TIER
#define ZEPH_PROFILE_BASE_WATER_QUALITY ZEPH_PROFILE_POTATO_WATER_QUALITY
#define ZEPH_PROFILE_BASE_WATER_TIER ZEPH_PROFILE_POTATO_WATER_TIER
#define ZEPH_PROFILE_BASE_WAVING_VEGETATION ZEPH_PROFILE_POTATO_WAVING_VEGETATION
#define ZEPH_PROFILE_BASE_WEATHER_QUALITY ZEPH_PROFILE_POTATO_WEATHER_QUALITY
#elif ZEPH_PROFILE_TIER == ZEPH_PROFILE_TIER_LOW
#define ZEPH_PROFILE_BASE_TIER ZEPH_PROFILE_LOW_TIER
#define ZEPH_PROFILE_BASE_FOG_QUALITY ZEPH_PROFILE_LOW_FOG_QUALITY
#define ZEPH_PROFILE_BASE_ATMOSPHERE_QUALITY ZEPH_PROFILE_LOW_ATMOSPHERE_QUALITY
#define ZEPH_PROFILE_BASE_FACE_LIGHTING_QUALITY ZEPH_PROFILE_LOW_FACE_LIGHTING_QUALITY
#define ZEPH_PROFILE_BASE_MATERIAL_QUALITY ZEPH_PROFILE_LOW_MATERIAL_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_QUALITY ZEPH_PROFILE_LOW_CLOUD_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_TIER ZEPH_PROFILE_LOW_CLOUD_TIER
#define ZEPH_PROFILE_BASE_WATER_QUALITY ZEPH_PROFILE_LOW_WATER_QUALITY
#define ZEPH_PROFILE_BASE_WATER_TIER ZEPH_PROFILE_LOW_WATER_TIER
#define ZEPH_PROFILE_BASE_WAVING_VEGETATION ZEPH_PROFILE_LOW_WAVING_VEGETATION
#define ZEPH_PROFILE_BASE_WEATHER_QUALITY ZEPH_PROFILE_LOW_WEATHER_QUALITY
#elif ZEPH_PROFILE_TIER == ZEPH_PROFILE_TIER_HIGH
#define ZEPH_PROFILE_BASE_TIER ZEPH_PROFILE_HIGH_TIER
#define ZEPH_PROFILE_BASE_FOG_QUALITY ZEPH_PROFILE_HIGH_FOG_QUALITY
#define ZEPH_PROFILE_BASE_ATMOSPHERE_QUALITY ZEPH_PROFILE_HIGH_ATMOSPHERE_QUALITY
#define ZEPH_PROFILE_BASE_FACE_LIGHTING_QUALITY ZEPH_PROFILE_HIGH_FACE_LIGHTING_QUALITY
#define ZEPH_PROFILE_BASE_MATERIAL_QUALITY ZEPH_PROFILE_HIGH_MATERIAL_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_QUALITY ZEPH_PROFILE_HIGH_CLOUD_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_TIER ZEPH_PROFILE_HIGH_CLOUD_TIER
#define ZEPH_PROFILE_BASE_WATER_QUALITY ZEPH_PROFILE_HIGH_WATER_QUALITY
#define ZEPH_PROFILE_BASE_WATER_TIER ZEPH_PROFILE_HIGH_WATER_TIER
#define ZEPH_PROFILE_BASE_WAVING_VEGETATION ZEPH_PROFILE_HIGH_WAVING_VEGETATION
#define ZEPH_PROFILE_BASE_WEATHER_QUALITY ZEPH_PROFILE_HIGH_WEATHER_QUALITY
#elif ZEPH_PROFILE_TIER == ZEPH_PROFILE_TIER_ULTRA
#define ZEPH_PROFILE_BASE_TIER ZEPH_PROFILE_ULTRA_TIER
#define ZEPH_PROFILE_BASE_FOG_QUALITY ZEPH_PROFILE_ULTRA_FOG_QUALITY
#define ZEPH_PROFILE_BASE_ATMOSPHERE_QUALITY ZEPH_PROFILE_ULTRA_ATMOSPHERE_QUALITY
#define ZEPH_PROFILE_BASE_FACE_LIGHTING_QUALITY ZEPH_PROFILE_ULTRA_FACE_LIGHTING_QUALITY
#define ZEPH_PROFILE_BASE_MATERIAL_QUALITY ZEPH_PROFILE_ULTRA_MATERIAL_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_QUALITY ZEPH_PROFILE_ULTRA_CLOUD_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_TIER ZEPH_PROFILE_ULTRA_CLOUD_TIER
#define ZEPH_PROFILE_BASE_WATER_QUALITY ZEPH_PROFILE_ULTRA_WATER_QUALITY
#define ZEPH_PROFILE_BASE_WATER_TIER ZEPH_PROFILE_ULTRA_WATER_TIER
#define ZEPH_PROFILE_BASE_WAVING_VEGETATION ZEPH_PROFILE_ULTRA_WAVING_VEGETATION
#define ZEPH_PROFILE_BASE_WEATHER_QUALITY ZEPH_PROFILE_ULTRA_WEATHER_QUALITY
#else
// Balanced is the safe fallback for a manually malformed tier definition.
#define ZEPH_PROFILE_BASE_TIER ZEPH_PROFILE_BALANCED_TIER
#define ZEPH_PROFILE_BASE_FOG_QUALITY ZEPH_PROFILE_BALANCED_FOG_QUALITY
#define ZEPH_PROFILE_BASE_ATMOSPHERE_QUALITY ZEPH_PROFILE_BALANCED_ATMOSPHERE_QUALITY
#define ZEPH_PROFILE_BASE_FACE_LIGHTING_QUALITY ZEPH_PROFILE_BALANCED_FACE_LIGHTING_QUALITY
#define ZEPH_PROFILE_BASE_MATERIAL_QUALITY ZEPH_PROFILE_BALANCED_MATERIAL_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_QUALITY ZEPH_PROFILE_BALANCED_CLOUD_QUALITY
#define ZEPH_PROFILE_BASE_CLOUD_TIER ZEPH_PROFILE_BALANCED_CLOUD_TIER
#define ZEPH_PROFILE_BASE_WATER_QUALITY ZEPH_PROFILE_BALANCED_WATER_QUALITY
#define ZEPH_PROFILE_BASE_WATER_TIER ZEPH_PROFILE_BALANCED_WATER_TIER
#define ZEPH_PROFILE_BASE_WAVING_VEGETATION ZEPH_PROFILE_BALANCED_WAVING_VEGETATION
#define ZEPH_PROFILE_BASE_WEATHER_QUALITY ZEPH_PROFILE_BALANCED_WEATHER_QUALITY
#endif

// Scene-grade controls do not enable an additional render path, so bounded
// overrides remain direct. Quality controls below are capped by the baseline.
#define ZEPH_EFFECTIVE_PROFILE_TIER ZEPH_PROFILE_BASE_TIER
#define ZEPH_EFFECTIVE_EXPOSURE ZEPH_EXPOSURE
#define ZEPH_EFFECTIVE_CONTRAST ZEPH_CONTRAST
#define ZEPH_EFFECTIVE_SATURATION ZEPH_SATURATION
#define ZEPH_EFFECTIVE_COLOUR_TEMPERATURE ZEPH_COLOUR_TEMPERATURE

#if ZEPH_FOG_QUALITY == 1 && ZEPH_PROFILE_BASE_FOG_QUALITY == 1
#define ZEPH_EFFECTIVE_FOG_QUALITY 1
#else
#define ZEPH_EFFECTIVE_FOG_QUALITY 0
#endif
#if ZEPH_ATMOSPHERE_QUALITY == 1 && ZEPH_PROFILE_BASE_ATMOSPHERE_QUALITY == 1
#define ZEPH_EFFECTIVE_ATMOSPHERE_QUALITY 1
#else
#define ZEPH_EFFECTIVE_ATMOSPHERE_QUALITY 0
#endif
#if ZEPH_FACE_LIGHTING_QUALITY < ZEPH_PROFILE_BASE_FACE_LIGHTING_QUALITY
#define ZEPH_EFFECTIVE_FACE_LIGHTING_QUALITY ZEPH_FACE_LIGHTING_QUALITY
#else
#define ZEPH_EFFECTIVE_FACE_LIGHTING_QUALITY ZEPH_PROFILE_BASE_FACE_LIGHTING_QUALITY
#endif
#if ZEPH_MATERIAL_QUALITY == 1 && ZEPH_PROFILE_BASE_MATERIAL_QUALITY == 1
#define ZEPH_EFFECTIVE_MATERIAL_QUALITY 1
#else
#define ZEPH_EFFECTIVE_MATERIAL_QUALITY 0
#endif
#if ZEPH_CLOUD_QUALITY == 1 && ZEPH_PROFILE_BASE_CLOUD_QUALITY == 1
#define ZEPH_EFFECTIVE_CLOUD_QUALITY 1
#else
#define ZEPH_EFFECTIVE_CLOUD_QUALITY 0
#endif
#if ZEPH_CLOUD_TIER < ZEPH_PROFILE_BASE_CLOUD_TIER
#define ZEPH_EFFECTIVE_CLOUD_TIER ZEPH_CLOUD_TIER
#else
#define ZEPH_EFFECTIVE_CLOUD_TIER ZEPH_PROFILE_BASE_CLOUD_TIER
#endif
#if ZEPH_WATER_QUALITY == 1 && ZEPH_PROFILE_BASE_WATER_QUALITY == 1
#define ZEPH_EFFECTIVE_WATER_QUALITY 1
#else
#define ZEPH_EFFECTIVE_WATER_QUALITY 0
#endif
#if ZEPH_WATER_TIER < ZEPH_PROFILE_BASE_WATER_TIER
