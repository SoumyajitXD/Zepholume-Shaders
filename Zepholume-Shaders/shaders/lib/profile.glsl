#else
#define ZEPH_EFFECTIVE_WATER_TIER ZEPH_PROFILE_BASE_WATER_TIER
#endif
#if ZEPH_WAVING_VEGETATION == 1 && ZEPH_PROFILE_BASE_WAVING_VEGETATION == 1
#define ZEPH_EFFECTIVE_WAVING_VEGETATION 1
#else
#define ZEPH_EFFECTIVE_WAVING_VEGETATION 0
#endif
#if ZEPH_WEATHER_QUALITY < ZEPH_PROFILE_BASE_WEATHER_QUALITY
#define ZEPH_EFFECTIVE_WEATHER_QUALITY ZEPH_WEATHER_QUALITY
#else
#define ZEPH_EFFECTIVE_WEATHER_QUALITY ZEPH_PROFILE_BASE_WEATHER_QUALITY
#endif

#endif
