#ifndef ZEPHO_PROFILE_GLSL
#define ZEPHO_PROFILE_GLSL

// Canonical Zepholume profile matrix. shaders.properties exposes these
// baselines through Iris/Oculus profiles; settings.glsl provides the Balanced
// defaults and the individual options remain available as bounded overrides.
#define ZEPH_PROFILE_TIER_POTATO 0
#define ZEPH_PROFILE_TIER_LOW 1
#define ZEPH_PROFILE_TIER_BALANCED 2
#define ZEPH_PROFILE_TIER_HIGH 3
#define ZEPH_PROFILE_TIER_ULTRA 4
#define ZEPH_PROFILE_TIER_DEFAULT ZEPH_PROFILE_TIER_BALANCED

// Keep this matrix declarative. Rendering libraries derive their profile paths
// from these bounded controls instead of adding independent profile switches
// at call sites. Each suffix maps to ZEPH_<suffix>, except TIER which maps to
// ZEPH_PROFILE_TIER. Static validation enforces shaders.properties exactly.
#define ZEPH_PROFILE_POTATO_TIER 0
#define ZEPH_PROFILE_POTATO_EXPOSURE 1
#define ZEPH_PROFILE_POTATO_CONTRAST 1
#define ZEPH_PROFILE_POTATO_SATURATION 1
#define ZEPH_PROFILE_POTATO_COLOUR_TEMPERATURE 1
#define ZEPH_PROFILE_POTATO_FOG_QUALITY 0
#define ZEPH_PROFILE_POTATO_ATMOSPHERE_QUALITY 0
#define ZEPH_PROFILE_POTATO_FACE_LIGHTING_QUALITY 0
#define ZEPH_PROFILE_POTATO_MATERIAL_QUALITY 0
#define ZEPH_PROFILE_POTATO_CLOUD_QUALITY 0
#define ZEPH_PROFILE_POTATO_CLOUD_TIER 0
#define ZEPH_PROFILE_POTATO_WATER_QUALITY 0
#define ZEPH_PROFILE_POTATO_WATER_TIER 0
#define ZEPH_PROFILE_POTATO_WAVING_VEGETATION 0
#define ZEPH_PROFILE_POTATO_WEATHER_QUALITY 0

#define ZEPH_PROFILE_LOW_TIER 1
#define ZEPH_PROFILE_LOW_EXPOSURE 1
#define ZEPH_PROFILE_LOW_CONTRAST 1
#define ZEPH_PROFILE_LOW_SATURATION 1
#define ZEPH_PROFILE_LOW_COLOUR_TEMPERATURE 1
#define ZEPH_PROFILE_LOW_FOG_QUALITY 1
#define ZEPH_PROFILE_LOW_ATMOSPHERE_QUALITY 1
#define ZEPH_PROFILE_LOW_FACE_LIGHTING_QUALITY 1
#define ZEPH_PROFILE_LOW_MATERIAL_QUALITY 0
#define ZEPH_PROFILE_LOW_CLOUD_QUALITY 1
#define ZEPH_PROFILE_LOW_CLOUD_TIER 1
#define ZEPH_PROFILE_LOW_WATER_QUALITY 1
#define ZEPH_PROFILE_LOW_WATER_TIER 1
#define ZEPH_PROFILE_LOW_WAVING_VEGETATION 1
#define ZEPH_PROFILE_LOW_WEATHER_QUALITY 1

#define ZEPH_PROFILE_BALANCED_TIER 2
#define ZEPH_PROFILE_BALANCED_EXPOSURE 1
#define ZEPH_PROFILE_BALANCED_CONTRAST 1
#define ZEPH_PROFILE_BALANCED_SATURATION 1
#define ZEPH_PROFILE_BALANCED_COLOUR_TEMPERATURE 2
#define ZEPH_PROFILE_BALANCED_FOG_QUALITY 1
#define ZEPH_PROFILE_BALANCED_ATMOSPHERE_QUALITY 1
#define ZEPH_PROFILE_BALANCED_FACE_LIGHTING_QUALITY 2
#define ZEPH_PROFILE_BALANCED_MATERIAL_QUALITY 1
#define ZEPH_PROFILE_BALANCED_CLOUD_QUALITY 1
#define ZEPH_PROFILE_BALANCED_CLOUD_TIER 2
#define ZEPH_PROFILE_BALANCED_WATER_QUALITY 1
#define ZEPH_PROFILE_BALANCED_WATER_TIER 2
#define ZEPH_PROFILE_BALANCED_WAVING_VEGETATION 1
#define ZEPH_PROFILE_BALANCED_WEATHER_QUALITY 1

#define ZEPH_PROFILE_HIGH_TIER 3
#define ZEPH_PROFILE_HIGH_EXPOSURE 1
#define ZEPH_PROFILE_HIGH_CONTRAST 2
#define ZEPH_PROFILE_HIGH_SATURATION 1
#define ZEPH_PROFILE_HIGH_COLOUR_TEMPERATURE 2
#define ZEPH_PROFILE_HIGH_FOG_QUALITY 1
#define ZEPH_PROFILE_HIGH_ATMOSPHERE_QUALITY 1
#define ZEPH_PROFILE_HIGH_FACE_LIGHTING_QUALITY 3
#define ZEPH_PROFILE_HIGH_MATERIAL_QUALITY 1
#define ZEPH_PROFILE_HIGH_CLOUD_QUALITY 1
#define ZEPH_PROFILE_HIGH_CLOUD_TIER 3
#define ZEPH_PROFILE_HIGH_WATER_QUALITY 1
#define ZEPH_PROFILE_HIGH_WATER_TIER 3
#define ZEPH_PROFILE_HIGH_WAVING_VEGETATION 1
#define ZEPH_PROFILE_HIGH_WEATHER_QUALITY 2

#define ZEPH_PROFILE_ULTRA_TIER 4
#define ZEPH_PROFILE_ULTRA_EXPOSURE 1
#define ZEPH_PROFILE_ULTRA_CONTRAST 2
#define ZEPH_PROFILE_ULTRA_SATURATION 2
#define ZEPH_PROFILE_ULTRA_COLOUR_TEMPERATURE 2
#define ZEPH_PROFILE_ULTRA_FOG_QUALITY 1
#define ZEPH_PROFILE_ULTRA_ATMOSPHERE_QUALITY 1
#define ZEPH_PROFILE_ULTRA_FACE_LIGHTING_QUALITY 3
#define ZEPH_PROFILE_ULTRA_MATERIAL_QUALITY 1
#define ZEPH_PROFILE_ULTRA_CLOUD_QUALITY 1
#define ZEPH_PROFILE_ULTRA_CLOUD_TIER 4
#define ZEPH_PROFILE_ULTRA_WATER_QUALITY 1
